{
  "name": "reclamations-cosemad",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme de gestion des réclamations clients du Groupe COSEMAD (portail client + back-office)",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verifier": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:init": "tsx prisma/seed/initialisation.ts",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "email:test": "tsx scripts/tester-email.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "nodemailer": "10.0.13"
  }
}
