# Copiez ce fichier en .env puis adaptez les valeurs. Ne commitez jamais .env.

# PostgreSQL local. Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL="postgresql://cosemad:cosemad@localhost:5432/reclamations?schema=public"

# Envoi des SMS et e-mails : « demo » (par défaut) enregistre les messages et les affiche sans les envoyer.
# « production » les envoie par le fournisseur configuré (à choisir : Orange, Free, Twilio…).
MESSAGERIE_MODE="demo"

# Dossier des pièces jointes en local (ignoré par Git).
STOCKAGE_DOSSIER="stockage"

# Ajoutée à l'étape 3 (connexion) — générer avec : npx auth secret
# AUTH_SECRET=""
