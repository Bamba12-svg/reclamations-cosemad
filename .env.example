# Copiez ce fichier en .env puis adaptez les valeurs. Ne commitez jamais .env.

# PostgreSQL local. Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL="postgresql://cosemad:cosemad@localhost:5432/reclamations?schema=public"
# En ligne (Neon) : DATABASE_URL = connexion « pooled » (hôte en -pooler), et la connexion directe ici,
# utilisée par les migrations (npm run db:deploy). Laisser vide en local.
# DATABASE_URL_UNPOOLED="postgresql://…@ep-xxx.eu-central-1.aws.neon.tech/reclamations?sslmode=require"

# Envoi des SMS et e-mails : « demo » (par défaut) enregistre les messages et les affiche sans les envoyer.
# « production » les envoie par le fournisseur configuré (à choisir : Orange, Free, Twilio…).
MESSAGERIE_MODE="demo"

# E-mails (SMTP). Chaque filiale écrit depuis SA boîte : variables suffixées _CM, _SON, _FLS.
# Test : npm run email:test -- vous@exemple.sn CM
# SMTP_HOTE="mail.infomaniak.com"
# SMTP_PORT="465"
# SMTP_UTILISATEUR_CM="prenom.nom@carrefourmedical.sn"
# SMTP_MOT_DE_PASSE_CM=""
# EMAIL_EXPEDITEUR_CM="Carrefour Médical – Réclamations <prenom.nom@carrefourmedical.sn>"
# SMTP_UTILISATEUR_SON="…"   SMTP_MOT_DE_PASSE_SON="…"   EMAIL_EXPEDITEUR_SON="…"
# SMTP_UTILISATEUR_FLS="…"   SMTP_MOT_DE_PASSE_FLS="…"   EMAIL_EXPEDITEUR_FLS="…"
# Boîte commune facultative, pour une filiale sans boîte propre :
# SMTP_UTILISATEUR="…"   SMTP_MOT_DE_PASSE="…"   EMAIL_EXPEDITEUR="…"
# L'adresse qui reçoit les réponses des clients se règle par filiale dans Paramètres → Modèles SMS et e-mail.

# Dossier des pièces jointes (ignoré par Git). En ligne : chemin absolu HORS du dossier de l'application,
# pour qu'une mise à jour du code ne l'efface jamais (voir docs/MISE-EN-LIGNE.md).
STOCKAGE_DOSSIER="stockage"

# Clé de chiffrement des sessions (32 caractères aléatoires minimum, différente en ligne).
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Mode démonstration : bouton « Remplir avec le compte de démonstration » et menu « Simuler un profil ».
# Mettre "0" dès que de vraies données sont saisies. En production (npm start), le serveur REFUSE de
# démarrer avec MODE_DEMO="1", sauf DEMO_EN_LIGNE="1" (démonstration publique, base sans données réelles).
MODE_DEMO="1"
# DEMO_EN_LIGNE="1"

# Adresse publique du portail : lien de suivi écrit dans le modèle de SMS créé par db:init et db:seed.
# PORTAIL_DOMAINE="reclamations.cosemad.sn"

# Premier compte Service QHSE d'une base de production (npm run db:init, une seule fois).
# INIT_QHSE_NOM="Prénom Nom"
# INIT_QHSE_EMAIL="prenom.nom@cosemad.sn"
# INIT_QHSE_MOT_DE_PASSE="12 caractères minimum, lettres et chiffres"
